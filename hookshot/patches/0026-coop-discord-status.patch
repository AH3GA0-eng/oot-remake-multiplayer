From cbce8ef60ad1e37f1c2a1e100360548400c01ab9 Mon Sep 17 00:00:00 2001
From: daurosk <354202035+daurosk@users.noreply.github.com>
Date: Mon, 16 Nov 2026 07:02:27 -0900
Subject: [PATCH] Co-op Discord status: the words and art from the options
 file, the module's line

host/discord_rpc.c: longshot_options.ini may set the status's words and
art next to discord_app_id=: discord_image= (an art asset key or an
https image of that application), discord_details= (first line),
discord_state= (second line), discord_large_text= (the art's hover
text). A key that is absent or not usable keeps Longshot's own. An
application other than Longshot's with no discord_image= gets no image
(Longshot's asset key belongs to Longshot's application), so Discord
shows that application's icon.

A loaded co-op module may give the second line itself through the
optional export hos_coop_discord_state(out, cap) (1 = a line written),
found by name as host/coop_world.c finds its exports, with a reference
held across the call. The words are checked every 5 s and a change is
sent at once; the 60 s keep-alive stays. The options file is read with
a 512-byte line (the rest of a longer line is skipped, not read as a
line of its own).

Generic: nothing co-op in the words; with no new keys and no module
the status is Longshot's as before.
---
 host/discord_rpc.c | 173 ++++++++++++++++++++++++++++++++++++---------
 1 file changed, 141 insertions(+), 32 deletions(-)

diff --git a/host/discord_rpc.c b/host/discord_rpc.c
index 5cb38b7..482456d 100644
--- a/host/discord_rpc.c
+++ b/host/discord_rpc.c
@@ -14,8 +14,16 @@
 
    The protocol is Discord's documented IPC (discord-rpc's rpc_connection.h): a frame is <opcode u32 LE><length u32 LE><JSON>,
    Handshake 0, Frame 1, Close 2, Ping 3, Pong 4. The handshake {"v":1,"client_id":...} is answered by a Ready frame; a
-   SET_ACTIVITY frame by a frame; a Ping is echoed as a Pong. */
+   SET_ACTIVITY frame by a frame; a Ping is echoed as a Pong.
+
+   (oot-remake-multiplayer's patch 0026) The status's words and art may come from longshot_options.ini too, for a mod's or a
+   kit's own Discord application: discord_image= (an art asset key of that application), discord_details= (the first line),
+   discord_state= (the second line) and discord_large_text= (the art's hover text); a key that is absent, or not usable, keeps
+   Longshot's own. A loaded co-op module may say the second line itself through the optional export hos_coop_discord_state
+   (found by name, as host/coop_world.c finds its exports): 1 = a line was written, 0 = none (the file's or Longshot's line).
+   The words are checked every 5 s and a change is sent at once; the file is read again every 15 s, as the id was. */
 #include "hos_paths.h"   /* (first: hos_game_path_a, and windows.h on Windows) */
+#include <stddef.h>   /* (patch 0026: offsetof) */
 #include <stdint.h>
 #include <stdio.h>
 #include <stdlib.h>
@@ -25,6 +33,7 @@
 #ifdef _WIN32
 #include <windows.h>
 #else
+#include <dlfcn.h>   /* (patch 0026: the module's hos_coop_discord_state) */
 #include <errno.h>
 #include <poll.h>
 #include <pthread.h>
@@ -135,9 +144,43 @@ static int valid_app_id(const char *s) {
         if (*s < '0' || *s > '9') return 0;
     return 1;
 }
-/* the application id: HOS_DISCORD_APP_ID, then longshot_options.ini's discord_app_id=, then the default */
-static void read_app_id(char *out, size_t cap) {
-    snprintf(out, cap, "%s", LONGSHOT_DISCORD_APP_ID_DEFAULT);
+/* (patch 0026) An art asset key or an image's https address: letters, digits and _ - . : / ? = & %, 1 to 255 of them */
+static int valid_image(const char *s) {
+    const size_t n = strlen(s);
+    if (!n || n > 255) return 0;
+    for (; *s; s++)
+        if (!((*s >= 'a' && *s <= 'z') || (*s >= 'A' && *s <= 'Z') || (*s >= '0' && *s <= '9') || strchr("_-.:/?=&%", *s)))
+            return 0;
+    return 1;
+}
+/* (patch 0026) Words for the status: 2 to 127 bytes (Discord refuses a line shorter than 2 or longer than 128 characters) with no
+   control character; the JSON escapes are added when the activity is written */
+static int valid_text(const char *s) {
+    const size_t n = strlen(s);
+    if (n < 2 || n > 127) return 0;
+    for (; *s; s++)
+        if ((unsigned char)*s < 0x20 || *s == 0x7f) return 0;
+    return 1;
+}
+typedef struct Settings {
+    char app_id[24];
+    char image[256];        /* "" Longshot's art */
+    char details[128];      /* "" Longshot's first line */
+    char state[128];        /* "" Longshot's second line */
+    char large_text[128];   /* "" Longshot's hover text */
+} Settings;
+/* the application id: HOS_DISCORD_APP_ID, then longshot_options.ini's discord_app_id=, then the default; and (patch 0026) the
+   file's discord_image=, discord_details=, discord_state=, discord_large_text= (each the last usable line of its key) */
+static void read_settings(Settings *s) {
+    static const struct { const char *key; size_t at; size_t cap; int (*ok)(const char *); } keys[] = {
+        {"discord_app_id=", offsetof(Settings, app_id), sizeof ((Settings *)0)->app_id, valid_app_id},
+        {"discord_image=", offsetof(Settings, image), sizeof ((Settings *)0)->image, valid_image},
+        {"discord_details=", offsetof(Settings, details), sizeof ((Settings *)0)->details, valid_text},
+        {"discord_state=", offsetof(Settings, state), sizeof ((Settings *)0)->state, valid_text},
+        {"discord_large_text=", offsetof(Settings, large_text), sizeof ((Settings *)0)->large_text, valid_text},
+    };
+    memset(s, 0, sizeof *s);
+    snprintf(s->app_id, sizeof s->app_id, "%s", LONGSHOT_DISCORD_APP_ID_DEFAULT);
     char path[1024];
     const DWORD n = hos_game_path_a(path, (DWORD)sizeof path);
     char *slash = n ? (strrchr(path, '\\') ? strrchr(path, '\\') : strrchr(path, '/')) : NULL;
@@ -145,18 +188,59 @@ static void read_app_id(char *out, size_t cap) {
         snprintf(slash + 1, (size_t)(path + sizeof path - slash - 1), "longshot_options.ini");
         FILE *f = fopen(path, "r");
         if (f) {
-            char line[128];
-            while (fgets(line, sizeof line, f))
-                if (!strncmp(line, "discord_app_id=", 15)) {
-                    line[strcspn(line, "\r\n")] = 0;
-                    if (valid_app_id(line + 15)) snprintf(out, cap, "%s", line + 15);
+            char line[512];
+            int line_start = 1;   /* (the rest of a line longer than the buffer is no line of its own) */
+            while (fgets(line, sizeof line, f)) {
+                const int starts = line_start;
+                line_start = strchr(line, '\n') != NULL;
+                if (!starts) continue;
+                line[strcspn(line, "\r\n")] = 0;
+                for (size_t k = 0; k < sizeof keys / sizeof *keys; k++) {
+                    const size_t kn = strlen(keys[k].key);
+                    if (strncmp(line, keys[k].key, kn) || !keys[k].ok(line + kn)) continue;
+                    snprintf((char *)s + keys[k].at, keys[k].cap, "%s", line + kn);
                 }
+            }
             fclose(f);
         }
     }
     const char *e = getenv("HOS_DISCORD_APP_ID");
-    if (e && valid_app_id(e)) snprintf(out, cap, "%s", e);
-    if (*out && !valid_app_id(out)) *out = 0;
+    if (e && valid_app_id(e)) snprintf(s->app_id, sizeof s->app_id, "%s", e);
+    if (*s->app_id && !valid_app_id(s->app_id)) *s->app_id = 0;
+}
+
+/* (patch 0026) The co-op module's second line: its optional export hos_coop_discord_state(out, cap), 1 = a line written. Looked
+   up again on each call (every 5 s): the module may load after the game starts, or not at all. */
+typedef int (*hos_coop_discord_state_fn)(char *out, size_t cap);
+static int module_state(char *out, size_t cap) {
+    if (cap < 2) return 0;
+    out[0] = 0;
+    int got = 0;
+    /* (a reference held across the call: the bridge frees a module that says co-op is off) */
+#ifdef _WIN32
+    HMODULE m = NULL;
+    if (!GetModuleHandleExA(0, "hookshot_coop.dll", &m)) return 0;
+    hos_coop_discord_state_fn fn = (hos_coop_discord_state_fn)(void *)GetProcAddress(m, "hos_coop_discord_state");
+    if (fn) got = fn(out, cap) == 1;
+    FreeLibrary(m);
+#else
+    void *m = dlopen("hookshot_coop.so", RTLD_NOW | RTLD_NOLOAD);
+    hos_coop_discord_state_fn fn =
+        (hos_coop_discord_state_fn)(m ? dlsym(m, "hos_coop_discord_state") : dlsym(RTLD_DEFAULT, "hos_coop_discord_state"));
+    if (fn) got = fn(out, cap) == 1;
+    if (m) dlclose(m);
+#endif
+    out[cap - 1] = 0;
+    return got && valid_text(out);
+}
+/* (patch 0026) s as a JSON string's inside: " and \ escaped (valid_text let no control character through) */
+static void json_text(char *out, size_t cap, const char *s) {
+    size_t o = 0;
+    for (; *s && o + 3 < cap; s++) {
+        if (*s == '"' || *s == '\\') out[o++] = '\\';
+        out[o++] = *s;
+    }
+    out[o] = 0;
 }
 
 /* ---- frames ---- */
@@ -217,17 +301,34 @@ static Ipc connect_client(const char *app_id) {
     }
     return IPC_NONE;
 }
-/* the activity: the release in the details, the start of play for the elapsed time, the application's art */
-static int send_activity(Ipc p, long long started) {
-    static unsigned nonce;
-    char version[48], json[640], answer[ANSWER_CAP];
+/* the activity: the release in the details, the start of play for the elapsed time, the application's art. (patch 0026) The
+   settings' words where they have them, the module's second line first; Longshot's art only for Longshot's own application (an
+   asset key belongs to one application: another's with no discord_image= gets no image, and Discord shows that application's
+   icon). Writes the activity's JSON into activity (the text compared for a change) */
+static void make_activity(char *activity, size_t cap, const Settings *s, const char *module_line, long long started) {
+    char version[48], details[256], state[256], large[256], image[300];
     snprintf(version, sizeof version, "%s", hos_version());
     version[strcspn(version, " +")] = 0;   /* ("v2.0.12 (source ...)": the release alone) */
-    snprintf(json, sizeof json,
-             "{\"cmd\":\"SET_ACTIVITY\",\"nonce\":\"%u\",\"args\":{\"pid\":%lu,\"activity\":{\"details\":\"Longshot\","
-             "\"state\":\"Longshot %s\",\"timestamps\":{\"start\":%lld},\"assets\":{\"large_image\":\"%s\",\"large_text\":"
-             "\"Longshot %s\"}}}}",
-             ++nonce, process_id(), version, started, LONGSHOT_DISCORD_IMAGE_DEFAULT, version);
+    char longshot[64];
+    snprintf(longshot, sizeof longshot, "Longshot %s", version);
+    json_text(details, sizeof details, *s->details ? s->details : "Ocarina of Time");
+    json_text(state, sizeof state, *module_line ? module_line : *s->state ? s->state : longshot);
+    json_text(large, sizeof large, *s->large_text ? s->large_text : longshot);
+    const char *art = *s->image ? s->image : !strcmp(s->app_id, LONGSHOT_DISCORD_APP_ID_DEFAULT) ? LONGSHOT_DISCORD_IMAGE_DEFAULT : "";
+    json_text(image, sizeof image, art);
+    if (*image)
+        snprintf(activity, cap,
+                 "{\"details\":\"%s\",\"state\":\"%s\",\"timestamps\":{\"start\":%lld},\"assets\":{\"large_image\":\"%s\","
+                 "\"large_text\":\"%s\"}}",
+                 details, state, started, image, large);
+    else
+        snprintf(activity, cap, "{\"details\":\"%s\",\"state\":\"%s\",\"timestamps\":{\"start\":%lld}}", details, state, started);
+}
+static int send_activity(Ipc p, const char *activity) {
+    static unsigned nonce;
+    char json[2048], answer[ANSWER_CAP];
+    snprintf(json, sizeof json, "{\"cmd\":\"SET_ACTIVITY\",\"nonce\":\"%u\",\"args\":{\"pid\":%lu,\"activity\":%s}}", ++nonce,
+             process_id(), activity);
     if (!write_frame(p, OP_FRAME, json)) return 0;
     uint32_t op = 0;
     const int r = read_frame(p, &op, answer, sizeof answer, 2000);
@@ -242,19 +343,19 @@ static int send_activity(Ipc p, long long started) {
 
 /* ---- the presence thread ---- */
 static void presence_main(void) {
-    char app_id[24];
-    read_app_id(app_id, sizeof app_id);
+    Settings set;
+    read_settings(&set);
     const long long started = (long long)time(NULL);
     Ipc ipc = IPC_NONE;
-    uint64_t retry_at = 0, send_at = 0, reread_at = now_ms() + 15000;
+    uint64_t retry_at = 0, send_at = 0, reread_at = now_ms() + 15000, words_at = 0;
     int said_no_client = 0, said_no_app = 0;
+    char module_line[128] = "", sent[1536] = "";
     for (;;) {
         sleep_ms(500);
         if (now_ms() >= reread_at) {   /* (an id typed into the options file while the game runs) */
-            char was[24];
-            memcpy(was, app_id, sizeof was);
-            read_app_id(app_id, sizeof app_id);
-            if (strcmp(was, app_id)) {
+            Settings was = set;
+            read_settings(&set);
+            if (strcmp(was.app_id, set.app_id)) {
                 if (ipc != IPC_NONE) ipc_close(ipc), ipc = IPC_NONE;
                 retry_at = 0, said_no_app = 0;
             }
@@ -264,7 +365,7 @@ static void presence_main(void) {
             if (ipc != IPC_NONE) ipc_close(ipc), ipc = IPC_NONE;
             continue;
         }
-        if (!app_id[0]) {
+        if (!set.app_id[0]) {
             if (!said_no_app)
                 hos_log("discord: no application id: discord_app_id= in longshot_options.ini or HOS_DISCORD_APP_ID (the "
                         "Discord application named Longshot); the status stays off");
@@ -272,23 +373,31 @@ static void presence_main(void) {
             continue;
         }
         if (ipc == IPC_NONE && now_ms() >= retry_at) {
-            ipc = connect_client(app_id);
+            ipc = connect_client(set.app_id);
             if (ipc == IPC_NONE) {
                 retry_at = now_ms() + 15000;
                 if (!said_no_client) hos_log("discord: no Discord client is running; trying again every 15 s");
                 said_no_client = 1;
             } else {
-                hos_log("discord: connected (application %s)", app_id);
+                hos_log("discord: connected (application %s)", set.app_id);
                 send_at = 0, said_no_client = 0;
             }
         }
-        if (ipc != IPC_NONE && now_ms() >= send_at) {
-            if (send_activity(ipc, started)) {
+        if (now_ms() >= words_at) {   /* (patch 0026: the module's line, and a change of the words sent at once) */
+            if (!module_state(module_line, sizeof module_line)) *module_line = 0;
+            words_at = now_ms() + 5000;
+        }
+        char activity[1536];
+        make_activity(activity, sizeof activity, &set, module_line, started);
+        if (ipc != IPC_NONE && (now_ms() >= send_at || strcmp(activity, sent))) {
+            if (send_activity(ipc, activity)) {
+                snprintf(sent, sizeof sent, "%s", activity);
                 send_at = now_ms() + 60000;
             } else {
                 hos_log("discord: the connection broke; connecting again");
                 ipc_close(ipc), ipc = IPC_NONE;
                 retry_at = now_ms() + 15000;
+                *sent = 0;
             }
         }
     }
