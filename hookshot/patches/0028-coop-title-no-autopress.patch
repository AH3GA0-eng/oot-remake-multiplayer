From 7b6c3cb24d69dded01282fee696f3f3f2c72e8f5 Mon Sep 17 00:00:00 2001
From: daurosk <354202035+daurosk@users.noreply.github.com>
Date: Mon, 16 Nov 2026 22:57:33 -0900
Subject: [PATCH] Co-op title: no presses of its own (Skip title screen off)

oot-remake-multiplayer's patch 0028 (player report 133). Longshot's
Skip title screen (host/oot_autoload.c, the Insert menu's Gameplay row)
presses A every 2 s from 20 s after the start, until the player runs or
120 s pass, so the game loads the most recent save by itself: no New
Game, no Host or Join from the title, and a guest's game is past the
title before the host's save can be taken. Its value is kept in
longshot_options.ini, which a kit's rebuild keeps, so a player who once
turned it on gets these presses at every start. A co-op build presses
nothing on the title by itself: hos_oot_autoload_input never arms its
presses (a saved skip_title_screen=1 is only logged), and row_shown
leaves the row off the menu, so the control bridge's option_set cannot
set it either. Nothing else changes.
---
 gpu/vk/vk_menu.cpp  | 2 ++
 host/oot_autoload.c | 9 +++++++--
 2 files changed, 9 insertions(+), 2 deletions(-)

diff --git a/gpu/vk/vk_menu.cpp b/gpu/vk/vk_menu.cpp
index d23a895..c566901 100644
--- a/gpu/vk/vk_menu.cpp
+++ b/gpu/vk/vk_menu.cpp
@@ -1987,6 +1987,8 @@ bool laptop_row() { return dev.props.deviceType == VK_PHYSICAL_DEVICE_TYPE_INTEG
 bool is_laptop_row(const Row& r) { return !r.value && r.tab == TAB_DEBUG && !strcmp(r.name, "Set up for a weak laptop"); }
 bool row_shown(int i) {
     const int* v = rows[i].value;
+    if (v == &opts.skip_title) return false;   // (oot-remake-multiplayer's patch 0028: a co-op build presses nothing on the
+                                               // title by itself, host/oot_autoload.c)
     return ((rows[i].cheat < 0 && v != &opts.damage_taken) || cheats_on()) && (v != &opts.reflex || reflex_available()) &&
            (v != &opts.antilag || antilag_available()) && (v != &opts.intel_compiles || intel_compiler_row()) &&
            (v != &opts.intel_quick || intel_compiler_row()) &&
diff --git a/host/oot_autoload.c b/host/oot_autoload.c
index 4110c56..9aad44d 100644
--- a/host/oot_autoload.c
+++ b/host/oot_autoload.c
@@ -187,8 +187,13 @@ void hos_oot_autoload_input(void) {
             hos_log("skip title: no saved game yet: the title screen stays");
             return;
         }
-        active = 1;
-        hos_log("skip title: %s is the most recent save: pressing A from %.0f s", save_path, kFirstMs / 1000.0);
+        /* (oot-remake-multiplayer's patch 0028) A co-op build presses nothing on the title by itself: the title is where
+           a player starts a new game, hosts or joins, and where a guest's game takes the host's save, so what it loads is
+           the player's choice alone. Skip title screen is not on the menu (vk_menu.cpp row_shown); a skip_title_screen=1
+           kept in longshot_options.ini (set once on an older kit; kit updates keep the file) is only logged: active
+           stays 0, so no press below */
+        hos_log("skip title: not in a co-op build: the title screen waits for the player (skip_title_screen=1 ignored; "
+                "%s is the most recent save)", save_path);
     }
     if (!active) return;
     if (!rx_option(HOS_OPT_SKIP_TITLE, 0)) {
