 /* ---- the helper's command line ---- */
@@ -488,8 +489,8 @@ static inline size_t hos_crash_message(char *out, size_t cap, int verdict, int s
     const int n = snprintf(out, cap,
                            "%s.\n\nWhat went wrong: %s\n\n%s"
