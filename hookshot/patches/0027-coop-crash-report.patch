                            headline, hos_crash_cause_text(cause),
                            send ? "Report automatically shows you what would go to the Longshot team, and sends it only when you "
                                   "press Send.\n\n" : "",
@@ -647,11 +648,11 @@ static inline size_t hos_crash_ready_text(char *out, size_t cap, int copied, int
         copied ? "The report is on your clipboard. "
         : saved ? "The report could not be put on the clipboard. Click Open the report, select all of it and copy it. "
                 : "The report could not be put on the clipboard, nor saved. ",
-        opened ? "In the issue form that opened in your browser, paste it into the longshot_log.txt box, say what you were doing, "
-                 "and fill in the rest."
+        opened ? "Send it as the page that opened in your browser says (/bugreport on Discord, or a GitHub issue with the "
+                 "kit's collect-logs zip), and say what you were doing."
                : "Open ",
         opened ? "" : issues,
-        opened ? "" : ", choose Game problem, and paste it into the longshot_log.txt box.",
+        opened ? "" : " and send it as that page says (/bugreport on Discord, or a GitHub issue with the kit's collect-logs zip).",
         saved ? "\n\nIt is saved as " : "", saved ? saved : "");
     size_t used = n < 0 ? 0 : (size_t)n < cap ? (size_t)n : cap ? cap - 1 : 0;
     const char *tail = saved ? "." : "";
diff --git a/nx2/addresses.ini b/nx2/addresses.ini
index be7990e9..619f4367 100644
--- a/nx2/addresses.ini
+++ b/nx2/addresses.ini
@@ -2,9 +2,10 @@
