From 01f2d9bfffe20edb9e1dd68ef1dd46701572e455 Mon Sep 17 00:00:00 2001
From: coop-fetch <coop-fetch@localhost>
Date: Mon, 16 Nov 2026 17:21:30 -0900
Subject: [PATCH] Co-op and Longshot's crash reports: nothing sent, co-op's
 lines kept out

A co-op build is not Longshot's to support (owner's decision): it sends
nothing to Longshot's services and never says it is a Longshot release.
host/hos_crash_dialog.c reads no address (no Report automatically, no silent
send of longshot_crash.ini) and its release flag is always 0; Report manually
saves and copies the report and opens co-op's page on reporting a problem
(host/hos_crash_dialog.h's words, HOS_CRASH_ISSUES); gpu/vk/perf_report.cpp
never starts (no performance summaries); nx2/addresses.ini has every address
empty.

The report co-op's players save and send to us leaves co-op's own log lines
out (server address, nicknames): both readers of the run log, crash_lines
and read_log, skip a line host/hos_coop_crash.h calls co-op's ("coop:" or
"coop voice:" after hos_log's tags and the module's level word).
---
 gpu/vk/perf_report.cpp  |  3 +++
 host/hos_coop_crash.h   | 44 +++++++++++++++++++++++++++++++++++++++++
 host/hos_crash_dialog.c | 15 +++++++-------
 host/hos_crash_dialog.h | 13 ++++++------
 nx2/addresses.ini       |  7 ++++---
 5 files changed, 66 insertions(+), 16 deletions(-)
 create mode 100644 host/hos_coop_crash.h

diff --git a/gpu/vk/perf_report.cpp b/gpu/vk/perf_report.cpp
index 702eb86b..8d276b9f 100644
--- a/gpu/vk/perf_report.cpp
+++ b/gpu/vk/perf_report.cpp
@@ -236,6 +236,9 @@ void at_exit() {
 
 bool perf_report_init() {
     folder = game_dir_path();
+    // (oot-remake-multiplayer's patch 0027) A co-op build measures and writes no performance statistics for Longshot,
+    // ticked or not: nothing for a launcher to send
+    if (true) return false;
     if (!ticked(folder)) return false;
     {   // (a summary cut short by an exit before: its .tmp, never sent and never counted)
         std::error_code ec;
diff --git a/host/hos_coop_crash.h b/host/hos_coop_crash.h
new file mode 100644
index 00000000..45b12ec9
--- /dev/null
+++ b/host/hos_coop_crash.h
@@ -0,0 +1,44 @@
+/* SPDX-License-Identifier: GPL-3.0-or-later
+   (oot-remake-multiplayer's patch 0027) A co-op build and Longshot's crash reports and statistics (rc.6's #983).
+
+   A co-op build is not Longshot's to support, so it sends nothing to Longshot's services and never says it is a Longshot
+   release (owner's decision, 2026-11-17: crashes go through co-op's own /bugreport and collect-logs):
+   - host/hos_crash_dialog.c: no address is ever read (find_addresses), so neither Report automatically nor the silent send
+     of longshot_crash.ini is offered; the report's release flag is always 0 ("No (a local or modified build)");
+   - Report manually still saves and copies the report, and opens HOS_COOP_CRASH_REPORT_PAGE below, not Longshot's issue
+     form (host/hos_crash_dialog.h's words say so);
+   - gpu/vk/perf_report.cpp: perf_report_init never starts, so no performance summary is measured or written;
+   - nx2/addresses.ini: every address empty, so the build's stamp has no crash_reports= and the sender has nowhere to send.
+
+   The report co-op's players save and send to us still leaves co-op's own log lines out: the module logs through hos_log
+   (patch 0001's bridge_log), so the run's log holds the server's address and the players' nicknames. Both readers of the
+   log (crash_lines and read_log) ask hos_coop_crash_private first and skip such a line.
+
+   A line as hos_log writes it: "[hos <thread>] [<level>] <text>" (the level tag only when not info); the module's own level
+   word ("warning: ", "error: ", "critical: ", hookshot/compat/common/logging.h) may lead the text. Co-op's text begins with
+   "coop:" (the module, patch 0001's bridge) or "coop voice:" (patch 0009). Plain C. */
+#ifndef HOS_COOP_CRASH_H
+#define HOS_COOP_CRASH_H
+#include <string.h>
+
+#define HOS_COOP_CRASH_REPORT_PAGE "https://github.com/daurosk/oot-remake-multiplayer/blob/main/docs/setup.md#reporting-a-problem"
+
+static inline const char *hos_coop_crash_skip_tag(const char *p) {   /* (one "[...] " at p, when there is one) */
+    if (*p != '[') return p;
+    const char *end = strchr(p, ']');
+    if (!end) return p;
+    for (p = end + 1; *p == ' '; p++) {}
+    return p;
+}
+
+static inline int hos_coop_crash_private(const char *line) {
+    const char *p = hos_coop_crash_skip_tag(hos_coop_crash_skip_tag(line));
+    static const char *const levels[] = {"warning: ", "error: ", "critical: "};
+    for (size_t i = 0; i < sizeof levels / sizeof *levels; i++)
+        if (!strncmp(p, levels[i], strlen(levels[i]))) {
+            p += strlen(levels[i]);
+            break;
+        }
+    return !strncmp(p, "coop:", 5) || !strncmp(p, "coop voice:", 11);
+}
+#endif
diff --git a/host/hos_crash_dialog.c b/host/hos_crash_dialog.c
index 4edd1a15..b68ee79f 100644
--- a/host/hos_crash_dialog.c
+++ b/host/hos_crash_dialog.c
@@ -301,6 +301,7 @@ static void read_log(RunLog *r, const Who *who) {
     for (uint64_t taken = 0; taken < (256ull << 20) && fgets(line, sizeof line, f);) {
         const size_t n = strlen(line);
         taken += n;
+        if (hos_coop_crash_private(line)) continue;   /* (patch 0027) */
         char *clean = redacted(who, line, n);
         if (!clean) continue;
         hos_crash_log_line(&r->facts, clean);
@@ -1071,7 +1072,8 @@ static void report_facts(const Shown *s, Report *out) {
         stamp_source[strcspn(stamp_source, " \t")] = 0;
         free(stamp);
     }
-    in.release = hos_crash_release(in.bare_version, source, stamp_source);
+    in.release = 0;   /* (patch 0027: a co-op build is never a Longshot release, whatever its version and source) */
+    (void)stamp_source;
     count_settings(&in);
     *out = in;
 }
@@ -1105,6 +1107,7 @@ static int make_report(const Shown *s, Made *out) {
     snprintf(where, sizeof where, "%s", f->place[0] ? f->place : s->log->found ? HOS_CRASH_TITLE_AND_INTRO : "");
     hos_crash_issue_url(out->url, sizeof out->url, title, in.version, f->gpu[0] ? in.gpu : "", system, what, track, where,
                         in.changed_list);
+    snprintf(out->url, sizeof out->url, "%s", HOS_COOP_CRASH_REPORT_PAGE);   /* (patch 0027: co-op's page, not Longshot's form) */
     {   /* (one separator between names: the game folder ends with one; a share's leading two kept) */
         const char *from = saved ? path : "";
         size_t o = 0;
@@ -1163,12 +1166,9 @@ static int sent_already(const Shown *s) {
     return t != NULL;
 }
 static void find_addresses(Shown *s) {
-    char path[PATH_MAX_UTF8];
-    char *stamp = join(path, sizeof path, s->dir, "longshot_version.txt") ? read_text(path, 16 << 10, NULL) : NULL;
-    if (!stamp || !hos_crash_stamp_address(stamp, "crash_reports", s->reports, sizeof s->reports) ||
-        !hos_crash_stamp_address(stamp, "crash_issue", s->issue, sizeof s->issue))
-        s->reports[0] = s->issue[0] = 0;
-    free(stamp);
+    /* (patch 0027) A co-op build sends nothing to Longshot: no address, so neither Report automatically nor the silent
+       send of longshot_crash.ini is ever offered, whatever the stamp says */
+    s->reports[0] = s->issue[0] = 0;
 }
 /* A line of the report, cleaned (hos_crash_clean), as a JSON string after sep */
 static void put_field(Buf *b, const char *sep, const char *key, const char *value, size_t limit, const Shown *s,
@@ -1246,6 +1246,7 @@ static int crash_lines(const Shown *s, Lines *tail, Lines *crash) {
     for (uint64_t taken = 0; taken < (256ull << 20) && fgets(line, sizeof line, f);) {
         taken += strlen(line);
         line[strcspn(line, "\r\n")] = 0;
+        if (hos_coop_crash_private(line)) continue;   /* (patch 0027) */
         if (!found && hos_crash_starts(line)) found = 1;
         if (!found) {   /* (the lines before it: the last 150, a ring) */
             if (ring.n < HOS_CRASH_TAIL_LINES) lines_add(&ring, line);
